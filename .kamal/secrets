# Secrets are decrypted at deploy time from an age-encrypted JSON file kept
# OUTSIDE this repository, on the deploy host only:
#
#   ~/.local/share/secrets/backstage.secrets.json.age
#
# NOTHING SECRET BELONGS IN THIS FILE. It is committed to a public repository.
# See docs/SECRETS.md for one-time setup and the rotation procedure.
#
# age prompts for the passphrase once; the single decrypt below is reused by
# every extract, so you are not asked ten times per deploy.
SECRETS=$(age --decrypt $HOME/.local/share/secrets/backstage.secrets.json.age)

SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE '$SECRETS')
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD '$SECRETS')
DB_PASSWORD=$(kamal secrets extract DB_PASSWORD '$SECRETS')
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD '$SECRETS')
RDS_PASSWORD=$(kamal secrets extract RDS_PASSWORD '$SECRETS')
AWS_ACCESS_KEY_ID=$(kamal secrets extract AWS_ACCESS_KEY_ID '$SECRETS')
AWS_SECRET_ACCESS_KEY=$(kamal secrets extract AWS_SECRET_ACCESS_KEY '$SECRETS')
MANDRILL_APIKEY=$(kamal secrets extract MANDRILL_APIKEY '$SECRETS')
MANDRILL_TEST_APIKEY=$(kamal secrets extract MANDRILL_TEST_APIKEY '$SECRETS')
MANDRILL_WEBHOOK_KEY=$(kamal secrets extract MANDRILL_WEBHOOK_KEY '$SECRETS')
