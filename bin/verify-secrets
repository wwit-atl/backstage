#!/usr/bin/env bash
#
# Verify the encrypted deploy secrets WITHOUT revealing them.
#
# Prints only key names, value lengths, and a status flag. Secret values never
# reach the terminal, the scrollback, or the shell history.
#
# Deliberately does NOT use `kamal secrets print` -- that dumps every secret in
# plaintext to stdout, which is unsafe to run interactively regardless of what
# you pipe it into.
#
# Usage: bin/verify-secrets
set -euo pipefail

SECRETS_FILE="${SECRETS_FILE:-$HOME/.local/share/secrets/backstage.secrets.json.age}"

if [ ! -f "$SECRETS_FILE" ]; then
  echo "not found: $SECRETS_FILE" >&2
  exit 1
fi

if [ ! -t 0 ] && [ ! -e /dev/tty ]; then
  echo "no terminal available; age cannot prompt for the passphrase." >&2
  echo "Run this from an interactive shell, not through a wrapper." >&2
  exit 1
fi

# Parse as JSON rather than splitting lines: a value containing a newline or an
# "=" would defeat line-based parsing and could echo a secret as a "key" name.
age --decrypt "$SECRETS_FILE" | ruby -rjson -rdigest -e '
  required = %w[
    SECRET_KEY_BASE KAMAL_REGISTRY_PASSWORD DB_PASSWORD POSTGRES_PASSWORD
    RDS_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY MANDRILL_APIKEY
    MANDRILL_TEST_APIKEY MANDRILL_WEBHOOK_KEY
  ]

  begin
    h = JSON.parse($stdin.read)
  rescue JSON::ParserError => e
    abort "decrypted content is not valid JSON: #{e.message}"
  end

  problems = []

  puts "%-26s %-6s %s" % %w[KEY LEN STATUS]
  required.each do |k|
    v = h[k]
    status =
      if v.nil?            then problems << k; "MISSING"
      elsif v.empty?       then problems << k; "EMPTY"
      elsif v.start_with?("FILL-ME-") then problems << k; "PLACEHOLDER"
      elsif v.include?("\x27")        then problems << k; "CONTAINS SINGLE QUOTE - will break deploy"
      else "ok"
      end
    puts "%-26s %-6s %s" % [ k, v.nil? ? "-" : v.length, status ]
  end

  extra = h.keys - required
  puts "\nunused keys present: #{extra.join(", ")}" unless extra.empty?

  skb = h["SECRET_KEY_BASE"].to_s
  puts "\nSECRET_KEY_BASE fingerprint: #{Digest::SHA256.hexdigest(skb)[0, 12]}"
  puts "  4b3a3ee8fc47 = the LEAKED key -- must never appear here"

  if problems.empty?
    puts "\nAll #{required.size} secrets present."
  else
    abort "\n#{problems.size} problem(s): #{problems.uniq.join(", ")}"
  end
'
